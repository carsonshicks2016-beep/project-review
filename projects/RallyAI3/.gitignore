# ── Unity generated ───────────────────────────────────────────────
# Library/ is a 2.3 GB import cache rebuilt from Assets/ + ProjectSettings/ on
# first open. It is machine-specific and must never be committed — including
# Library/ScriptAssemblies, which check-compile.sh references but Unity rebuilds.
/Library/
/Temp/
/Obj/
/obj/
/Logs/
/MemoryCaptures/
/Recordings/
/[Bb]uild/
/[Bb]uilds/

# Per-user editor layout and preferences, not project configuration.
/UserSettings/

# Visual Studio / Rider / VS Code project files, regenerated from the asmdefs.
/[Ee]xported[Oo]bj/
/*.csproj
/*.unityproj
/*.sln
/*.suo
/*.user
/*.userprefs
/*.pidb
/*.booproj
/*.svd
/*.pdb
/*.mdb
/*.opendb
/*.VC.db
/.vs/
/.idea/
/.vscode/

# Unity crash / asset-server leftovers
sysinfo.txt
*.stackdump
crashlytics-build.properties
/[Aa]ssets/[Aa]ssetStoreTools*
/[Aa]ssets/[Pp]lugins/[Ee]ditor/JetBrains*

# ── Python training environment ───────────────────────────────────
# 625 MB, and reproducible from config/README.md's pinned install recipe.
/.venv/
__pycache__/
*.py[cod]

# ── Offline harness artifacts ─────────────────────────────────────
# Both are regenerated by ./check-audio.sh; the .cs sources ARE tracked.
/Tools/audio-check/out/
/Tools/audio-check/*.exe

# ML-Agents writes profiling timers here on every run. Runtime artifact, not config.
/Assets/ML-Agents/Timers/

# ── Training results ──────────────────────────────────────────────
# ONNX policies, TensorBoard events and resolved configs are tracked: they are
# the experimental record and they are small (6.5 MB total).
#
# Torch checkpoints (*.pt, 26 MB) are dropped EXCEPT rally05's, because rally05
# is the 85 %-stage-finish policy and its .pt is the only thing that can
# continue training from it (--resume / --initialize-from). The abandoned runs'
# checkpoints are dead ends and not worth the weight.
results/**/*.pt
!results/rally05/**/*.pt

# ── macOS ─────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── Local tool state ──────────────────────────────────────────────
# Machine-local permission allowlist, not shared project config.
.claude/settings.local.json
# Managed experiments, generated Unity bundles and dashboard dependencies.
.rally/
Assets/RallyLabGenerated/
Assets/RallyLabGenerated.meta
dashboard/node_modules/
dashboard/dist/
dashboard/test-results/

# Private migration exclusions
.env
.env.*
!.env.example
*.db
*.sqlite*
*.pt
*.pth
*.onnx
*.npz
*.pkl
*.sfc
*.smc
*.iso
*.ciso
node_modules/
.venv*/
__pycache__/
data/
sessions/
uploads/
runs/
checkpoints/
Library/
Builds/
config.local.json

{
  "name": "sonic-scenery",
  "version": "0.0.0",
  "private": true,
  "description": "Spotify-driven 3D procedural scenery, creatures, and weather",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test:gen": "esbuild src/generation/generationCore.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/gen-test.mjs && node node_modules/.cache/gen-test.mjs",
    "helper:build": "swift build --package-path helper"
  },
  "dependencies": {
    "node-vibrant": "^4.0.0",
    "seedrandom": "^3.0.5",
    "simplex-noise": "^4.0.3",
    "three": "^0.171.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/seedrandom": "^3.0.8",
    "@types/three": "^0.171.0",
    "@types/ws": "^8.5.13",
    "electron": "^33.0.0",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}

{
  "name": "supra-fable-observatory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "python3 ../tools/build_observatory_assets.py",
    "assets:check": "python3 ../tools/build_observatory_assets.py --check",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "validate": "npm run assets:check && npm test && npm run build"
  },
  "dependencies": {
    "puppeteer": "^25.3.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "vite": "8.1.5"
  }
}

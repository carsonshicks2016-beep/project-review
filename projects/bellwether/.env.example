# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Phase 3 extraction (provider-agnostic; see PLAN §9) ---
# Triage uses Gemini free tier. Deep-read model is chosen by the Step 3.10 eval.
# Gemini API key (free tier). https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Anthropic API — only needed if the eval picks Claude for deep read.
# https://console.anthropic.com
ANTHROPIC_API_KEY=
# Which provider does the deep read: gemini | anthropic  (set by the 3.10 eval)
DEEP_READ_PROVIDER=gemini

# Financial Modeling Prep (Phase 1 — fundamentals/analyst counts). Free tier ok for v1.
FMP_API_KEY=

# SEC EDGAR requires a User-Agent in EXACTLY this format or it will IP-ban you:
#   "Your Name user@example.com"
SEC_USER_AGENT=Your Name user@example.com

# Path to the SQLite database (default fine).
BELLWETHER_DB=bellwether.db

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
